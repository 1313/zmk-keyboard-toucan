# Root Kconfig for this repo when used as a Zephyr module.
#
# Gate the vendored SDC integration behind a top-level "attempt" symbol
# so the vendored Kconfig (which references newer-than-our-Zephyr
# symbols) doesn't break non-SD builds during the iteration phase.
#
# Enable via -DCONFIG_TOUCAN_SDC_ATTEMPT=y on the SD build variants.

# Shim: ZMK's Zephyr v4.1+zmk-fixes uses SOC_COMPATIBLE_NRF52X but the
# unmodified nrfxlib Kconfigs (mpsl, softdevice_controller) and the
# vendored sdk-nrf bits both check the older SOC_SERIES_NRF52 name.
# Mirror the new symbol back as the old one so dependency clauses
# inside other modules' Kconfigs evaluate correctly without patching.
config SOC_SERIES_NRF52
	bool
	default y if SOC_COMPATIBLE_NRF52X

config TOUCAN_SDC_ATTEMPT
	bool "Enable the experimental vendored SoftDevice Controller integration"
	default n

if TOUCAN_SDC_ATTEMPT
rsource "modules/sdc/Kconfig"
endif
